# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SMTP Configuration for secure OTP and Login verification email dispatch
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Firebase Admin Service Account JSON secret
FIREBASE_SERVICE_ACCOUNT=""

# Platform Owner Identity (Server-only secret)
PLATFORM_OWNER_EMAIL="admin@your-domain.com"

# APP_PEPPER: Server-side cryptographic pepper for password hashing.
# CRITICAL: A long, randomly generated secret MUST be set per deployment and never committed.
APP_PEPPER="REPLACE_WITH_LONG_RANDOM_SECRET_NEVER_COMMIT"

# STRICT_PROD_SECURITY: Enables strict production security mode (disables non-strict fallback peppers and plaintext dev fallback).
STRICT_PROD_SECURITY="true"

# TEMPORARY: set to true to skip all login / password checks (dev only)
AUTH_BYPASS=true

