// ⚠️ WARNING: DO NOT DEPLOY THIS FILE TO PRODUCTION!
// This file is an emergency fallback ruleset that grants public access (READ & WRITE) to all documents.
// It must only be used for debugging or catastrophic disaster recovery purposes under strict sandbox environments.
// Deploying this file will expose ALL user data and business records of CustodyFlow to the public.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
