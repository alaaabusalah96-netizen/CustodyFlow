rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core helper functions
    function isLoggedIn() {
      return request.auth != null;
    }

    function isSystemAdmin() {
      return isLoggedIn() && (
        request.auth.token.email == 'alaaabusalah96@gmail.com' ||
        request.auth.token.email == 'alaabusalah96@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SystemAdmin')
      );
    }

    function userDocExists() {
      return isLoggedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getCompanyId() {
      return userDocExists() ? getUserData().company_id : "";
    }

    function getUserRole() {
      return userDocExists() ? getUserData().role : "";
    }

    function isSameCompanyRead(resourceData) {
      return isSystemAdmin() || (
        isLoggedIn() && 
        getCompanyId() != "" && 
        resourceData != null && 
        resourceData.company_id == getCompanyId()
      );
    }

    function isSameCompanyWrite(requestData, resourceData) {
      return isSystemAdmin() || (
        isLoggedIn() &&
        getCompanyId() != "" &&
        requestData != null &&
        requestData.company_id == getCompanyId() &&
        (resourceData == null || resourceData.company_id == getCompanyId())
      );
    }

    // --- Companies ---
    match /companies/{id} {
      allow read: if isLoggedIn() && (isSystemAdmin() || id == getCompanyId());
      allow write: if isSystemAdmin() || (isLoggedIn() && id == getCompanyId() && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin'));
    }

    // --- Transactions (Custody Transactions) ---
    match /transactions/{id} {
      allow read: if isSameCompanyRead(resource.data);
      allow create, update: if isSameCompanyWrite(request.resource.data, resource.data);
      allow delete: if isSameCompanyWrite(resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin');
    }

    // --- GL Accounts (Chart of Accounts) ---
    match /gl_accounts/{id} {
      allow read: if isSameCompanyRead(resource.data);
      allow write: if isSameCompanyWrite(request.resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin' || getUserRole() == 'Accountant');
    }

    // --- Journal Entries (Immutable Accounting Entries) ---
    match /journal_entries/{id} {
      allow read: if isSameCompanyRead(resource.data);
      allow create: if isSameCompanyWrite(request.resource.data, null) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin' || getUserRole() == 'Accountant');
      allow update, delete: if false; // Journal entries are immutable
    }

    // --- Company Sequences ---
    match /company_sequences/{id} {
      allow read: if isSameCompanyRead(resource.data);
      allow write: if isSameCompanyWrite(request.resource.data, resource.data);
    }

    // --- CashVouchers (CamelCase) ---
    match /CashVouchers/{id} {
      allow read: if isSameCompanyRead(resource.data);
      allow write: if isSameCompanyWrite(request.resource.data, resource.data);
    }

    // --- Expenses (CamelCase) ---
    match /Expenses/{id} {
      allow read: if isSameCompanyRead(resource.data);
      allow create, update: if isSameCompanyWrite(request.resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin' || getUserRole() == 'Manager' || getUserRole() == 'Accountant');
      allow delete: if isSameCompanyWrite(resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin');
    }

    // --- TransactionHistory ---
    match /TransactionHistory/{id} {
      allow read: if isSameCompanyRead(resource.data);
      allow write: if isSameCompanyWrite(request.resource.data, resource.data);
    }

    // --- deleted_transactions ---
    match /deleted_transactions/{id} {
      allow read: if isSameCompanyRead(resource.data);
      allow write: if isSameCompanyWrite(request.resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin');
    }

    // --- business_groups ---
    match /business_groups/{id} {
      allow read: if isSameCompanyRead(resource.data);
      allow write: if isSameCompanyWrite(request.resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin');
    }

    // --- warehouse_bins ---
    match /warehouse_bins/{id} {
      allow read: if isSameCompanyRead(resource.data);
      allow write: if isSameCompanyWrite(request.resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin' || getUserRole() == 'Storekeeper');
    }

    // --- vendors ---
    match /vendors/{id} {
      allow read: if isSameCompanyRead(resource.data);
      allow write: if isSameCompanyWrite(request.resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin' || getUserRole() == 'Accountant');
    }

    // --- purchase_requests ---
    match /purchase_requests/{id} {
      allow read: if isSameCompanyRead(resource.data);
      allow write: if isSameCompanyWrite(request.resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin' || getUserRole() == 'Manager' || getUserRole() == 'Accountant');
    }

    // --- customers ---
    match /customers/{id} {
      allow read: if isSameCompanyRead(resource.data);
      allow write: if isSameCompanyWrite(request.resource.data, resource.data);
    }

    // --- leads ---
    match /leads/{id} {
      allow read: if isSameCompanyRead(resource.data);
      allow write: if isSameCompanyWrite(request.resource.data, resource.data);
    }

    // --- sales_invoices ---
    match /sales_invoices/{id} {
      allow read: if isSameCompanyRead(resource.data);
      allow write: if isSameCompanyWrite(request.resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin' || getUserRole() == 'Accountant');
    }

    // --- pos_transactions ---
    match /pos_transactions/{id} {
      allow read: if isSameCompanyRead(resource.data);
      allow write: if isSameCompanyWrite(request.resource.data, resource.data);
    }

    // --- employees_payroll_items ---
    match /employees_payroll_items/{id} {
      allow read: if isSameCompanyRead(resource.data);
      allow write: if isSameCompanyWrite(request.resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin');
    }

    // --- fixed_assets_items ---
    match /fixed_assets_items/{id} {
      allow read: if isSameCompanyRead(resource.data);
      allow write: if isSameCompanyWrite(request.resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin' || getUserRole() == 'Accountant');
    }

    // --- payroll_processed_runs ---
    match /payroll_processed_runs/{id} {
      allow read: if isSameCompanyRead(resource.data);
      allow write: if isSameCompanyWrite(request.resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin');
    }

    // --- Users ---
    match /users/{id} {
      allow read: if isLoggedIn() && (id == request.auth.uid || isSystemAdmin() || (resource != null && resource.data.company_id == getCompanyId()));
      allow create: if isLoggedIn() && (id == request.auth.uid || isSystemAdmin() || (isLoggedIn() && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin') && request.resource.data.company_id == getCompanyId()));
      allow update: if isLoggedIn() && (id == request.auth.uid || isSystemAdmin() || (isLoggedIn() && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin') && resource.data.company_id == getCompanyId() && request.resource.data.company_id == getCompanyId()));
      allow delete: if isLoggedIn() && (isSystemAdmin() || (isLoggedIn() && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin') && resource.data.company_id == getCompanyId()));
    }

    // --- Roles & Permissions ---
    match /roles/{id} {
      allow read: if isLoggedIn();
      allow write: if isSystemAdmin() || (isLoggedIn() && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin') && (resource == null || resource.data.company_id == getCompanyId()) && (request.resource == null || request.resource.data.company_id == getCompanyId()));
    }

    match /Roles/{id} {
      allow read: if isLoggedIn();
      allow write: if isSystemAdmin() || (isLoggedIn() && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin') && (resource == null || resource.data.company_id == getCompanyId()) && (request.resource == null || request.resource.data.company_id == getCompanyId()));
    }

    match /permissions/{id} {
      allow read: if isLoggedIn();
      allow write: if isSystemAdmin() || (isLoggedIn() && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin') && (resource == null || resource.data.company_id == getCompanyId()) && (request.resource == null || request.resource.data.company_id == getCompanyId()));
    }

    match /Permissions/{id} {
      allow read: if isLoggedIn();
      allow write: if isSystemAdmin() || (isLoggedIn() && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin') && (resource == null || resource.data.company_id == getCompanyId()) && (request.resource == null || request.resource.data.company_id == getCompanyId()));
    }

    // --- Branches ---
    match /branches/{id} {
      allow read: if isSameCompanyRead(resource.data);
      allow create, update: if isSameCompanyWrite(request.resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin' || getUserRole() == 'Manager');
      allow delete: if isSameCompanyWrite(resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin');
    }

    // --- Regions & Stations ---
    match /regions/{id} {
      allow read: if isSameCompanyRead(resource.data);
      allow create, update: if isSameCompanyWrite(request.resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin' || getUserRole() == 'Manager');
      allow delete: if isSameCompanyWrite(resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin');
    }

    match /stations/{id} {
      allow read: if isSameCompanyRead(resource.data);
      allow create, update: if isSameCompanyWrite(request.resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin' || getUserRole() == 'Manager');
      allow delete: if isSameCompanyWrite(resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin');
    }

    // --- Warehouses & Products ---
    match /warehouses/{id} {
      allow read: if isSameCompanyRead(resource.data);
      allow create, update: if isSameCompanyWrite(request.resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin' || getUserRole() == 'Manager' || getUserRole() == 'Storekeeper');
      allow delete: if isSameCompanyWrite(resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin');
    }

    match /products/{id} {
      allow read: if isSameCompanyRead(resource.data);
      allow create, update: if isSameCompanyWrite(request.resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin' || getUserRole() == 'Manager' || getUserRole() == 'Storekeeper');
      allow delete: if isSameCompanyWrite(resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin');
    }

    // --- Inventory & Stock Movements ---
    match /inventory/{id} {
      allow read: if isSameCompanyRead(resource.data);
      allow create, update: if isSameCompanyWrite(request.resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin' || getUserRole() == 'Manager' || getUserRole() == 'Storekeeper');
      allow delete: if isSameCompanyWrite(resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin');
    }

    match /stock_movements/{id} {
      allow read: if isSameCompanyRead(resource.data);
      allow create, update: if isSameCompanyWrite(request.resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin' || getUserRole() == 'Manager' || getUserRole() == 'Storekeeper');
      allow delete: if isSameCompanyWrite(resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin');
    }

    match /inventory_ledger/{id} {
      allow read: if isSameCompanyRead(resource.data);
      allow create, update: if isSameCompanyWrite(request.resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin' || getUserRole() == 'Manager' || getUserRole() == 'Storekeeper');
      allow delete: if isSameCompanyWrite(resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin');
    }

    // --- Receipts, Issues, Returns & Transfers ---
    match /receipts/{id} {
      allow read: if isSameCompanyRead(resource.data);
      allow create, update: if isSameCompanyWrite(request.resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin' || getUserRole() == 'Manager' || getUserRole() == 'Storekeeper');
      allow delete: if isSameCompanyWrite(resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin');
    }

    match /issues/{id} {
      allow read: if isSameCompanyRead(resource.data);
      allow create, update: if isSameCompanyWrite(request.resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin' || getUserRole() == 'Manager' || getUserRole() == 'Storekeeper');
      allow delete: if isSameCompanyWrite(resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin');
    }

    match /returns/{id} {
      allow read: if isSameCompanyRead(resource.data);
      allow create, update: if isSameCompanyWrite(request.resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin' || getUserRole() == 'Manager' || getUserRole() == 'Storekeeper');
      allow delete: if isSameCompanyWrite(resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin');
    }

    match /transfers/{id} {
      allow read: if isSameCompanyRead(resource.data);
      allow create, update: if isSameCompanyWrite(request.resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin' || getUserRole() == 'Manager' || getUserRole() == 'Storekeeper');
      allow delete: if isSameCompanyWrite(resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin');
    }

    // --- Purchase & Sales Orders ---
    match /purchase_orders/{id} {
      allow read: if isSameCompanyRead(resource.data);
      allow create, update: if isSameCompanyWrite(request.resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin' || getUserRole() == 'Manager' || getUserRole() == 'Accountant');
      allow delete: if isSameCompanyWrite(resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin');
    }

    match /sales_orders/{id} {
      allow read: if isSameCompanyRead(resource.data);
      allow create, update: if isSameCompanyWrite(request.resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin' || getUserRole() == 'Manager' || getUserRole() == 'Accountant');
      allow delete: if isSameCompanyWrite(resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin');
    }

    // --- Logistics: Vehicles & Drivers ---
    match /vehicles/{id} {
      allow read: if isSameCompanyRead(resource.data);
      allow create, update: if isSameCompanyWrite(request.resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin' || getUserRole() == 'Manager');
      allow delete: if isSameCompanyWrite(resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin');
    }

    match /drivers/{id} {
      allow read: if isSameCompanyRead(resource.data);
      allow create, update: if isSameCompanyWrite(request.resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin' || getUserRole() == 'Manager');
      allow delete: if isSameCompanyWrite(resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin');
    }

    // --- Fuel, Maintenance & Expenses ---
    match /fuel_logs/{id} {
      allow read: if isSameCompanyRead(resource.data);
      allow create, update: if isSameCompanyWrite(request.resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin' || getUserRole() == 'Manager' || getUserRole() == 'Driver' || getUserRole() == 'Accountant');
      allow delete: if isSameCompanyWrite(resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin');
    }

    match /maintenance/{id} {
      allow read: if isSameCompanyRead(resource.data);
      allow create, update: if isSameCompanyWrite(request.resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin' || getUserRole() == 'Manager' || getUserRole() == 'Accountant');
      allow delete: if isSameCompanyWrite(resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin');
    }

    match /expenses/{id} {
      allow read: if isSameCompanyRead(resource.data);
      allow create, update: if isSameCompanyWrite(request.resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin' || getUserRole() == 'Manager' || getUserRole() == 'Accountant');
      allow delete: if isSameCompanyWrite(resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin');
    }

    // --- Settings & Configurations ---
    match /settings/{id} {
      allow read: if isSameCompanyRead(resource.data);
      allow write: if isSameCompanyWrite(request.resource.data, resource.data) && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin');
    }

    match /config/{id} {
      allow read: if isLoggedIn();
      allow write: if isSystemAdmin() || (isLoggedIn() && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin'));
    }

    // --- Notifications ---
    match /notifications/{id} {
      allow read: if isSameCompanyRead(resource.data);
      allow write: if isSameCompanyWrite(request.resource.data, resource.data);
    }

    // --- Attachments ---
    match /attachments/{id} {
      allow read: if isSameCompanyRead(resource.data);
      allow write: if isSameCompanyWrite(request.resource.data, resource.data);
    }

    // --- Audit Logs, Activity Logs & Logs (Immutable protection) ---
    match /activity_logs/{id} {
      allow read: if isSameCompanyRead(resource.data);
      allow create: if isSameCompanyWrite(request.resource.data, null);
      allow update, delete: if false; // Strict modification protection
    }

    match /AuditLogs/{id} {
      allow read: if isLoggedIn() && (isSystemAdmin() || (getCompanyId() != "" && (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin')));
      allow create: if isSameCompanyWrite(request.resource.data, null);
      allow update, delete: if false; // Strict modification protection
    }

    match /logs/{id} {
      allow read: if isSameCompanyRead(resource.data);
      allow create: if isSameCompanyWrite(request.resource.data, null);
      allow update, delete: if false; // Strict modification protection
    }

    // --- Categories & System Meta ---
    match /categories/{id} {
      allow read: if isLoggedIn();
      allow write: if isSystemAdmin();
    }

    match /system_meta/{id} {
      allow read: if isLoggedIn();
      allow write: if isSystemAdmin();
    }

    // --- Signup Requests ---
    match /signup_requests/{id} {
      allow create: if isLoggedIn();
      allow read, update, delete: if isSystemAdmin() || (
        isLoggedIn() && 
        (getUserRole() == 'Admin' || getUserRole() == 'SystemAdmin') && 
        (resource == null || resource.data.company_id == getCompanyId())
      );
    }
  }
}
