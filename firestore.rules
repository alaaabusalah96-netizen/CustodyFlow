rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Is the user a SystemAdmin?
    function isSystemAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'alaaabusalah96@gmail.com' ||
        request.auth.token.email == 'alaabusalah96@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SystemAdmin')
      );
    }

    // Helper: Is the user logged in?
    function isLoggedIn() {
      return request.auth != null;
    }

    // Helper: Get user's own data from Firestore
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper: Get user's company_id
    function getCompanyId() {
      return getUserData().company_id;
    }

    // Helper: Is the user an Admin or SystemAdmin?
    function isAdminOrSystemAdmin() {
      return isSystemAdmin() || (isLoggedIn() && (
        getUserData().role == 'Admin' || getUserData().role == 'SystemAdmin'
      ));
    }

    // --- Signup Requests (Public Access for Registration) ---
    match /signup_requests/{id} {
      allow read, write: if true;
    }

    // --- Users Collection ---
    match /users/{id} {
      allow read: if isSystemAdmin() || (isLoggedIn() && (
        resource == null || 
        resource.data.company_id == getCompanyId() || 
        id == request.auth.uid
      ));
      allow write: if isSystemAdmin() || (isLoggedIn() && (
        id == request.auth.uid || 
        (isAdminOrSystemAdmin() && (
          (resource == null && request.resource.data.company_id == getCompanyId()) ||
          (resource != null && resource.data.company_id == getCompanyId() && request.resource.data.company_id == getCompanyId())
        ))
      ));
    }

    // --- Companies Collection ---
    match /companies/{id} {
      allow read: if isSystemAdmin() || (isLoggedIn() && id == getCompanyId());
      allow write: if isSystemAdmin() || (isLoggedIn() && id == getCompanyId() && isAdminOrSystemAdmin());
    }

    // --- Regions & Stations ---
    match /regions/{id} {
      allow read: if isSystemAdmin() || (isLoggedIn() && (resource == null || resource.data.company_id == getCompanyId()));
      allow write: if isSystemAdmin() || (isLoggedIn() && (resource == null || resource.data.company_id == getCompanyId()) && isAdminOrSystemAdmin());
    }

    match /stations/{id} {
      allow read: if isSystemAdmin() || (isLoggedIn() && (resource == null || resource.data.company_id == getCompanyId()));
      allow write: if isSystemAdmin() || (isLoggedIn() && (resource == null || resource.data.company_id == getCompanyId()) && isAdminOrSystemAdmin());
    }

    // --- Expense Categories (Shared read, write by SystemAdmin) ---
    match /categories/{id} {
      allow read: if isLoggedIn();
      allow write: if isSystemAdmin();
    }

    // --- Multi-Tenant Collections (Must match user's company_id) ---
    match /transactions/{id} {
      allow read: if isSystemAdmin() || (isLoggedIn() && (resource == null || resource.data.company_id == getCompanyId()));
      allow write: if isSystemAdmin() || (isLoggedIn() && (resource == null || resource.data.company_id == getCompanyId() || request.resource.data.company_id == getCompanyId()));
    }

    match /Expenses/{id} {
      allow read: if isSystemAdmin() || (isLoggedIn() && (resource == null || resource.data.company_id == getCompanyId()));
      allow write: if isSystemAdmin() || (isLoggedIn() && (resource == null || resource.data.company_id == getCompanyId() || request.resource.data.company_id == getCompanyId()));
    }

    match /CashVouchers/{id} {
      allow read: if isSystemAdmin() || (isLoggedIn() && (resource == null || resource.data.company_id == getCompanyId()));
      allow write: if isSystemAdmin() || (isLoggedIn() && (resource == null || resource.data.company_id == getCompanyId() || request.resource.data.company_id == getCompanyId()));
    }

    match /TransactionHistory/{id} {
      allow read: if isSystemAdmin() || (isLoggedIn() && (resource == null || resource.data.company_id == getCompanyId()));
      allow write: if isSystemAdmin() || (isLoggedIn() && (resource == null || resource.data.company_id == getCompanyId() || request.resource.data.company_id == getCompanyId()));
    }

    match /Notifications/{id} {
      allow read: if isSystemAdmin() || (isLoggedIn() && (resource == null || resource.data.company_id == getCompanyId()));
      allow write: if isSystemAdmin() || (isLoggedIn() && (resource == null || resource.data.company_id == getCompanyId() || request.resource.data.company_id == getCompanyId()));
    }

    match /deleted_transactions/{id} {
      allow read: if isSystemAdmin() || (isLoggedIn() && (resource == null || resource.data.company_id == getCompanyId()));
      allow write: if isSystemAdmin() || (isLoggedIn() && (resource == null || resource.data.company_id == getCompanyId() || request.resource.data.company_id == getCompanyId()));
    }

    match /company_sequences/{id} {
      allow read: if isSystemAdmin() || (isLoggedIn() && (resource == null || resource.data.company_id == getCompanyId()));
      allow write: if isSystemAdmin() || (isLoggedIn() && (resource == null || resource.data.company_id == getCompanyId() || request.resource.data.company_id == getCompanyId()));
    }

    // --- Configuration, System Logs & Permissions ---
    match /config/{id} {
      allow read: if isLoggedIn();
      allow write: if isSystemAdmin() || isAdminOrSystemAdmin();
    }

    match /logs/{id} {
      allow read: if isSystemAdmin() || (isLoggedIn() && (resource == null || resource.data.company_id == getCompanyId()));
      allow write: if isLoggedIn();
    }

    match /AuditLogs/{id} {
      allow read: if isSystemAdmin() || (isLoggedIn() && isAdminOrSystemAdmin());
      allow write: if isLoggedIn();
    }

    match /Permissions/{id} {
      allow read: if isLoggedIn();
      allow write: if isSystemAdmin() || isAdminOrSystemAdmin();
    }

    match /Roles/{id} {
      allow read: if isLoggedIn();
      allow write: if isSystemAdmin() || isAdminOrSystemAdmin();
    }

    // --- System Meta ---
    match /system_meta/{id} {
      allow read, write: if true;
    }
  }
}
